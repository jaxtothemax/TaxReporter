# Auto-detect text files and normalize line endings
* text=auto

# Force LF line endings for all text files (cross-platform consistency)
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.go    text eol=lf
*.rs    text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.env   text eol=lf

# Lock files — generated, use union merge to reduce conflicts
package-lock.json   merge=union
yarn.lock           merge=union
pnpm-lock.yaml      merge=union

# Binary files — do not diff or merge
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.pdf   binary

# Generated files — show in diff but mark as generated
# CUSTOMIZE: Add your generated files (e.g. API types, compiled assets)
# packages/web/src/api/types.ts  linguist-generated=true
