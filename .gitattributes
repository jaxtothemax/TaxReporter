# Auto-detect text files and normalize line endings
* text=auto

# Force LF line endings for all text files (cross-platform consistency)
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.go    text eol=lf
*.rs    text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.env   text eol=lf

# Lock files — generated, use union merge to reduce conflicts
package-lock.json   merge=union
yarn.lock           merge=union
pnpm-lock.yaml      merge=union

# Broker-export and tax-form fixtures — keep them byte-exact. Real broker
# exports ship CRLF line endings, byte-order marks and non-UTF-8 encodings, and
# `* text=auto` above would normalize line endings on commit: a parser test then
# passes against a file no broker ever produced. `-text` stores them as-is.
# CUSTOMIZE: point these at the fixture directories once they exist.
# tests/fixtures/** -text
# **/fixtures/**/*.csv -text

# Vendored FURS eDavki schemas — byte-exact copies of what FURS publishes (CRLF
# line endings; Doh_KDVP_9.xsd also opens with a UTF-8 byte-order mark). Their
# SHA-256 is pinned in packages/furs/schemas/README.md and asserted by
# packages/furs/src/index.test.ts, so `* text=auto` normalizing them would break
# every pin. `-text` stores them as-is and still leaves them diffable, for the
# day FURS edits one in place.
packages/furs/schemas/*.xsd -text

# Golden files — the writers' exact output, compared byte for byte. A Windows
# checkout with `* text=auto` would turn their LF into CRLF and fail every
# comparison, so the line endings are pinned to what the writers produce.
packages/*/test/fixtures/golden/*.xml text eol=lf

# Binary files — do not diff or merge
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.pdf   binary

# Generated files — show in diff but mark as generated
# CUSTOMIZE: Add your generated files (e.g. API types, compiled assets)
# packages/web/src/api/types.ts  linguist-generated=true
